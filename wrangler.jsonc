{
  // Threefold Cord icebreaker — Worker that serves the static site and the
  // /api endpoints (see worker.js). The D1 binding (variable name: DB) is
  // added in the Cloudflare dashboard: Worker → Bindings → Add → D1 database.
  "name": "threecordicebreaker",
  "main": "worker.js",
  "compatibility_date": "2024-12-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  }
}
